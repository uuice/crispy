generator client {
  provider      = "prisma-client"
  output        = "../src/prisma"
  runtime       = "bun"
  moduleFormat  = "esm"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "windows", "darwin", "darwin-arm64", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model permissions {
  id          String    @id @db.VarChar(36)
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(50)
  description String?   @db.VarChar(200)
  type        String    @db.VarChar(20)
  status      String    @default("active") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  roles       roles[]   @relation("RolePermissions")

  @@index([code])
  @@index([status])
  @@index([type])
}

model roles {
  id          String        @id @db.VarChar(36)
  name        String        @unique @db.VarChar(50)
  description String?       @db.VarChar(200)
  status      String        @default("active") @db.VarChar(20)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  permissions permissions[] @relation("RolePermissions")
  users       users[]       @relation("UserRoles")

  @@index([name])
  @@index([status])
}

model users {
  id          String    @id @db.VarChar(36)
  name        String    @db.VarChar(50)
  email       String    @unique @db.VarChar(255)
  avatar      String?   @db.VarChar(500)
  password    String    @db.VarChar(255)
  status      String    @default("inactive") @db.VarChar(20)
  lastLoginAt DateTime?
  lastLoginIp String?   @db.VarChar(45)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  roles       roles[]   @relation("UserRoles")

  @@index([createdAt])
  @@index([email])
  @@index([status])
}
