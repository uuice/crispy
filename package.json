{
  "name": "crispy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "bun run --env-file ./.env ng serve",
    "build": "ng build && bun scripts/copy-server-assets.ts",
    "build:fallback": "ng build && bun scripts/copy-templates.js && bun scripts/verify-templates.js",
    "build:tar": "bun run --env-file ./.env build && tar -czf crispy-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env.example",
    "build:tar:prod": "bun run --env-file ./.env build && tar -czf crispy-prod-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env.example",
    "build:tar:clean": "rm -rf dist/ && bun run --env-file ./.env build && tar -czf crispy-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env.example",
    "build:tar:with-env": "bun run --env-file ./.env build && tar -czf crispy-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env .env.example",
    "build:tar:full": "bun run --env-file ./.env build && tar -czf crispy-full-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env .env.example bun.lock",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:crispy": "bun run --expose-gc --env-file ./.env dist/crispy/server/server.mjs",
    "del:spec": "find . -type f -name '*.spec.ts' -delete",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "lint:strict": "eslint \"src/**/*.{ts,html}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,html,less,json}\"",
    "db:generate": "kysely-codegen --out-file ./src/db/db.d.ts",
    "db:migrate": "bun run --env-file ./.env migrations/migrator.ts up",
    "db:migrate:down": "bun run --env-file ./.env migrations/migrator.ts down",
    "db:setup": "bun run db:migrate && bun run db:generate",
    "migrate": "bun run --env-file ./.env scripts/migrate.ts",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:dev": "pm2 start ecosystem.config.js --only crispy-dev-bun",
    "pm2:start:dev:node": "pm2 start ecosystem.config.js --only crispy-dev-node",
    "pm2:start:dev:bun": "pm2 start ecosystem.config.js --only crispy-dev-bun",
    "pm2:start:ssr": "pm2 start ecosystem.config.js --only crispy-ssr-bun",
    "pm2:start:ssr:node": "pm2 start ecosystem.config.js --only crispy-ssr-node",
    "pm2:start:ssr:bun": "pm2 start ecosystem.config.js --only crispy-ssr-bun",
    "pm2:start:watch": "pm2 start ecosystem.config.js --only crispy-watch-bun",
    "pm2:start:watch:node": "pm2 start ecosystem.config.js --only crispy-watch-node",
    "pm2:start:watch:bun": "pm2 start ecosystem.config.js --only crispy-watch-bun",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production --only crispy-ssr-bun",
    "pm2:start:prod:node": "pm2 start ecosystem.config.js --env production --only crispy-ssr-node",
    "pm2:start:prod:bun": "pm2 start ecosystem.config.js --env production --only crispy-ssr-bun",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "templates:style:build": "bun x postcss src/server/templates/styles/style.css -o public/assets/styles/style.css",
    "templates:style:watch": "bun x postcss src/server/templates/styles/style.css -o public/assets/styles/style.css --watch",
    "templates:style:build:prod": "NODE_ENV=production bun x postcss src/server/templates/styles/style.css -o public/assets/styles/style.css"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.3",
    "@angular/cdk": "^20.1.3",
    "@angular/common": "^20.1.3",
    "@angular/compiler": "^20.1.3",
    "@angular/core": "^20.1.3",
    "@angular/forms": "^20.1.3",
    "@angular/platform-browser": "^20.1.3",
    "@angular/platform-server": "^20.1.3",
    "@angular/router": "^20.1.3",
    "@angular/ssr": "^20.1.2",
    "@elysiajs/html": "^1.4.0",
    "@elysiajs/server-timing": "^1.4.0",
    "@elysiajs/static": "^1.4.7",
    "@primeng/themes": "^20.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nunjucks": "^3.2.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "colorjs.io": "^0.5.2",
    "express": "^5.1.0",
    "flexsearch": "^0.8.205",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.3",
    "lodash": "^4.17.21",
    "marked": "^16.1.2",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.2",
    "nunjucks": "^3.2.4",
    "openai": "^5.12.0",
    "pinyin": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.2",
    "swagger-jsdoc": "^6.2.8",
    "tslib": "^2.8.1",
    "vditor": "^3.11.1",
    "xml2js": "^0.6.2",
    "zod": "^4.0.8"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/schematics": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/build": "^20.1.2",
    "@angular/cli": "^20.1.2",
    "@angular/compiler-cli": "^20.1.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/express": "^5.0.3",
    "@types/jasmine": "~5.1.8",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jasmine-core": "~5.7.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "kysely-codegen": "^0.18.5",
    "kysely-migration-cli": "^0.4.2",
    "less": "^4.4.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  }
}
