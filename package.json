{
  "name": "crispy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "bun run --env-file ./.env ng serve",
    "prebuild": "bun run swagger:generate",
    "build": "ng build",
    "build:tar": "bun run --env-file ./.env build && tar -czf crispy-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env.example",
    "build:tar:prod": "bun run --env-file ./.env build && tar -czf crispy-prod-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env.example",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:crispy": "bun run --expose-gc --env-file ./.env dist/crispy/server/server.mjs",
    "del:spec": "find . -type f -name '*.spec.ts' -delete",
    "clean:empty-dirs": "bash scripts/clean-empty-dirs.sh",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "lint:strict": "eslint \"src/**/*.{ts,html}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,html,less,json}\"",
    "db:generate": "kysely-codegen --out-file ./src/db/db.d.ts --dialect mysql",
    "db:migrate": "bun run --env-file ./.env migrations/migrator.ts up",
    "db:migrate:down": "bun run --env-file ./.env migrations/migrator.ts down",
    "db:setup": "bun run db:migrate && bun run db:generate && bun run doc:tables",
    "doc:tables": "bun scripts/generate-table-metadata.ts",
    "migrate": "bun run --env-file ./.env scripts/migrate.ts",
    "swagger:generate": "bun run --env-file ./.env scripts/generate-swagger.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/cdk": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-server": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@angular/ssr": "^21.1.3",
    "@primeng/themes": "^21.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "colorjs.io": "^0.6.1",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.11",
    "lodash": "^4.17.23",
    "marked": "^17.0.1",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "mysql2": "^3.17.0",
    "openai": "^6.21.0",
    "pinyin": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.2",
    "swagger-jsdoc": "^6.2.8",
    "tslib": "^2.8.1",
    "vditor": "^3.11.2",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.2.0",
    "@angular-eslint/eslint-plugin": "^21.2.0",
    "@angular-eslint/eslint-plugin-template": "^21.2.0",
    "@angular-eslint/schematics": "^21.2.0",
    "@angular-eslint/template-parser": "^21.2.0",
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jquery": "^3.5.33",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "kysely-codegen": "^0.19.0",
    "kysely-migration-cli": "^0.4.2",
    "less": "^4.5.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  }
}
