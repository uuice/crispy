{
  "name": "crispy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "bun run --env-file ./.env ng serve",
    "build": "ng build",
    "build:tar": "npm run build && tar -czf crispy-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env .env.example",
    "build:tar:prod": "npm run build && tar -czf crispy-prod-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env .env.example",
    "build:tar:clean": "rm -rf dist/ && npm run build && tar -czf crispy-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env .env.example",
    "build:tar:with-env": "npm run build && tar -czf crispy-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env .env.example",
    "build:tar:full": "npm run build && tar -czf crispy-full-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json .env .env.example bun.lock",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:crispy": "bun run --env-file ./.env dist/crispy/server/server.mjs",
    "del:spec": "find . -type f -name '*.spec.ts' -delete",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "lint:strict": "eslint \"src/**/*.{ts,html}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,html,less,json}\"",
    "db:generate": "kysely-codegen --out-file ./src/db/db.d.ts",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:dev": "pm2 start ecosystem.config.js --only crispy-dev",
    "pm2:start:ssr": "pm2 start ecosystem.config.js --only crispy-ssr",
    "pm2:start:watch": "pm2 start ecosystem.config.js --only crispy-watch",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.3",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.2",
    "@primeng/themes": "^19.1.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.13",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.2",
    "multer": "^2.0.1",
    "mysql2": "^3.14.1",
    "primeicons": "^6.0.1",
    "primeng": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@angular-eslint/builder": "~19.3.0",
    "@angular-eslint/eslint-plugin": "~19.3.0",
    "@angular-eslint/eslint-plugin-template": "~19.3.0",
    "@angular-eslint/schematics": "~19.3.0",
    "@angular-eslint/template-parser": "~19.3.0",
    "@angular/build": "^20.0.2",
    "@angular/cli": "^20.0.2",
    "@angular/compiler-cli": "^20.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "kysely-codegen": "^0.18.5",
    "less": "^4.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2"
  }
}
