// Content 路由的AI模块
export const aiRouter = t.router({
  // AI测试
  test: tokenProtectedProcedure.query(async () => {
    try {
      const testResult = await aiService.test()
      return {
        success: true,
        data: testResult
      }
    } catch (error) {
      return {
        success: false,
        data: null,
        error: error instanceof Error ? error.message : 'AI测试失败'
      }
    }
  }),

  // AI摘要生成
  summary: tokenProtectedProcedure
    .input(({ content, language = 'zh' }) => ({ content, language }))
    .mutation(async ({ input }) => {
      try {
        const summary = await aiService.generateSummary(input.content, input.language)
        return {
          success: true,
          data: summary
        }
      } catch (error) {
        return {
          success: false,
          data: null,
          error: error instanceof Error ? error.message : 'AI摘要生成失败'
        }
      }
    }),

  // AI标签生成
  tags: tokenProtectedProcedure
    .input(({ content, count = 5 }) => ({ content, count: Number(count) }))
    .mutation(async ({ input }) => {
      try {
        const tags = await aiService.generateTags(input.content, input.count)
        return {
          success: true,
          data: tags
        }
      } catch (error) {
        return {
          success: false,
          data: [],
          error: error instanceof Error ? error.message : 'AI标签生成失败'
        }
      }
    }),

  // AI SEO描述生成
  seoDescription: tokenProtectedProcedure
    .input(({ title, content, keywords = [] }) => ({ title, content, keywords }))
    .mutation(async ({ input }) => {
      try {
        const description = await aiService.generateSeoDescription(input.title, input.content, input.keywords)
        return {
          success: true,
          data: description
        }
      } catch (error) {
        return {
          success: false,
          data: null,
          error: error instanceof Error ? error.message : 'AI SEO描述生成失败'
        }
      }
    }),

  // AI翻译
  translate: tokenProtectedProcedure
    .input(({ text, targetLanguage = 'zh' }) => ({ text, targetLanguage }))
    .mutation(async ({ input }) => {
      try {
        const translated = await aiService.translate(input.text, input.targetLanguage)
        return {
          success: true,
          data: translated
        }
      } catch (error) {
        return {
          success: false,
          data: null,
          error: error instanceof Error ? error.message : 'AI翻译失败'
        }
      }
    }),

  // AI代码解释
  explainCode: tokenProtectedProcedure
    .input(({ code, language }) => ({ code, language }))
    .mutation(async ({ input }) => {
      try {
        const explanation = await aiService.explainCode(input.code, input.language)
        return {
          success: true,
          data: explanation
        }
      } catch (error) {
        return {
          success: false,
          data: null,
          error: error instanceof Error ? error.message : 'AI代码解释失败'
        }
      }
    }),

  // AI标题生成
  titles: tokenProtectedProcedure
    .input(({ content, count = 5 }) => ({ content, count: Number(count) }))
    .mutation(async ({ input }) => {
      try {
        const titles = await aiService.generateTitles(input.content, input.count)
        return {
          success: true,
          data: titles
        }
      } catch (error) {
        return {
          success: false,
          data: [],
          error: error instanceof Error ? error.message : 'AI标题生成失败'
        }
      }
    }),

  // AI聊天
  chat: tokenProtectedProcedure
    .input(({ message, context = [] }) => ({ message, context }))
    .mutation(async ({ input }) => {
      try {
        const response = await aiService.chat(input.message, input.context)
        return {
          success: true,
          data: response
        }
      } catch (error) {
        return {
          success: false,
          data: null,
          error: error instanceof Error ? error.message : 'AI聊天失败'
        }
      }
    })
})

// Content 主路由器 - 包含所有公共模块
export const contentRouter = t.router({
  // 用户相关模块
  publicUser: publicUserRouter,
  // 文章相关模块
  publicArticle: publicArticleRouter,
  // 分类相关模块
  publicCategory: publicCategoryRouter,
  // 标签相关模块
  publicTag: publicTagRouter,
  // 评论相关模块
  publicComment: publicCommentRouter,
  // 配置相关模块
  publicConfig: publicConfigRouter,
  // 链接相关模块
  publicLink: publicLinkRouter,
  // 菜单相关模块
  publicMenu: publicMenuRouter,
  // 页面相关模块
  publicPage: publicPageRouter,
  // 广告相关模块
  publicAd: publicAdRouter,
  // 广告项相关模块
  publicAdItem: publicAdItemRouter,
  // 角色相关模块
  publicRole: publicRoleRouter,
  // 权限规则相关模块
  publicRule: publicRuleRouter,
  // 用户类型相关模块
  publicUserType: publicUserTypeRouter,
  // 属性相关模块
  publicAttr: publicAttrRouter,
  // 缓存相关模块
  publicCache: publicCacheRouter,
  // 枚举相关模块
  publicEnum: publicEnumRouter,
  // 节假日相关模块
  publicHoliday: publicHolidayRouter,
  // 工作职位相关模块
  publicJob: publicJobRouter,
  // 关键词相关模块
  publicKeyword: publicKeywordRouter,
  // 通知相关模块
  publicNotice: publicNoticeRouter,
  // 操作日志相关模块
  publicOperateLog: publicOperateLogRouter,
  // API日志相关模块
  publicApiLog: publicApiLogRouter,
  // 访问令牌相关模块
  publicAccessToken: publicAccessTokenRouter,
  // 系统信息相关模块
  publicSystem: publicSystemRouter,
  // 搜索相关模块
  search: searchRouter,
  // AI相关模块
  ai: aiRouter
})

// 导出类型定义
export type ContentRouter = typeof contentRouter
