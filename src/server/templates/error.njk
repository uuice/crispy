{% extends "base.njk" %}

{% block title %}{{ title or '错误' }} - {{ siteConfig.site_name or 'Crispy' }}{% endblock %}

{% block description %}{{ message or '页面出现错误' }}{% endblock %}

{% block content %}
<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <!-- 错误图标 -->
      <div class="mx-auto h-24 w-24 text-gray-400 mb-6">
        {% if statusCode == 404 %}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        {% elif statusCode == 403 %}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        {% elif statusCode == 500 %}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        {% else %}
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        {% endif %}
      </div>

      <!-- 错误码 -->
      <h1 class="text-6xl font-bold text-gray-900 mb-4">{{ statusCode or '错误' }}</h1>
      
      <!-- 错误标题 -->
      <h2 class="text-2xl font-semibold text-gray-700 mb-4">{{ title or '出现错误' }}</h2>
      
      <!-- 错误消息 -->
      <p class="text-gray-600 mb-8 max-w-sm mx-auto">{{ message or '页面出现了一些问题，请稍后重试。' }}</p>

      <!-- 操作按钮 -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button onclick="history.back()" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            返回上页
          </button>
          
          <a href="/" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            回到首页
          </a>
        </div>

        {% if statusCode == 404 %}
          <div class="mt-6">
            <a href="/blog" class="text-blue-600 hover:text-blue-800 transition-colors">
              或者浏览我们的博客文章
            </a>
          </div>
        {% endif %}
      </div>

      <!-- 额外信息 -->
      {% if statusCode == 404 %}
        <div class="mt-8 p-4 bg-blue-50 rounded-lg">
          <h3 class="text-sm font-medium text-blue-800 mb-2">可能的原因：</h3>
          <ul class="text-sm text-blue-700 space-y-1">
            <li>• 页面地址输入错误</li>
            <li>• 页面已被删除或移动</li>
            <li>• 链接已过期</li>
          </ul>
        </div>
      {% elif statusCode == 500 %}
        <div class="mt-8 p-4 bg-red-50 rounded-lg">
          <h3 class="text-sm font-medium text-red-800 mb-2">如果问题持续存在：</h3>
          <ul class="text-sm text-red-700 space-y-1">
            <li>• 请稍后重试</li>
            <li>• 清除浏览器缓存</li>
            <li>• 联系网站管理员</li>
          </ul>
        </div>
      {% endif %}

      <!-- 搜索框 -->
      {% if statusCode == 404 %}
        <div class="mt-8">
          <form action="/blog/search" method="get" class="max-w-sm mx-auto">
            <div class="flex">
              <input type="text" name="q" placeholder="搜索内容..." class="flex-1 px-3 py-2 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
              <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-r-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors text-sm">
                搜索
              </button>
            </div>
          </form>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
// 自动刷新功能（仅在服务器错误时）
{% if statusCode == 500 %}
  let retryCount = 0;
  const maxRetries = 3;
  
  function autoRetry() {
    if (retryCount < maxRetries) {
      retryCount++;
      setTimeout(() => {
        console.log(`自动重试第 ${retryCount} 次...`);
        window.location.reload();
      }, 5000 * retryCount); // 递增延迟
    }
  }
  
  // 5秒后开始第一次重试
  setTimeout(autoRetry, 5000);
{% endif %}

// 错误报告功能
function reportError() {
  if (navigator.sendBeacon) {
    const errorData = {
      statusCode: {{ statusCode or 0 }},
      message: '{{ message | escape }}',
      url: window.location.href,
      userAgent: navigator.userAgent,
      timestamp: new Date().toISOString()
    };
    
    navigator.sendBeacon('/api/error-report', JSON.stringify(errorData));
  }
}

// 页面加载完成后报告错误
document.addEventListener('DOMContentLoaded', reportError);
</script>
{% endblock %}
