{% extends "base.njk" %}

{% block title %}博客列表 - Crispy{% endblock %}

{% block description %}浏览最新的博客文章和技术分享{% endblock %}

{% block content %}
<div class="text-center mb-3">
  <h1>博客文章</h1>
  <p class="text-muted">分享技术见解和生活感悟</p>
</div>

{% if posts and posts.length > 0 %}
  <div class="blog-grid">
    {% for post in posts %}
    <article class="card">
      <h2 class="mb-2">
        <a href="/blog/{{ post.slug }}" style="text-decoration: none; color: #333;">
          {{ post.title }}
        </a>
      </h2>
      
      <div class="text-muted mb-2">
        <span>发布于 {{ post.created_at | dateFormat('YYYY-MM-DD') }}</span>
        {% if post.author %}
        <span> · 作者: {{ post.author }}</span>
        {% endif %}
        {% if post.category %}
        <span> · 分类: {{ post.category }}</span>
        {% endif %}
      </div>
      
      {% if post.excerpt %}
      <p class="mb-2">{{ post.excerpt | stripHtml | truncate(150) }}</p>
      {% endif %}
      
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <a href="/blog/{{ post.slug }}" class="btn">阅读更多</a>
        {% if post.tags and post.tags.length > 0 %}
        <div class="tags">
          {% for tag in post.tags %}
          <span style="background: #f1f1f1; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; margin-left: 0.5rem;">
            {{ tag }}
          </span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
  
  {% if pagination %}
  <div class="text-center mt-3">
    <div style="display: inline-flex; gap: 1rem; align-items: center;">
      {% if pagination.hasPrev %}
      <a href="?page={{ pagination.prevPage }}" class="btn">上一页</a>
      {% endif %}
      
      <span class="text-muted">
        第 {{ pagination.currentPage }} 页，共 {{ pagination.totalPages }} 页
      </span>
      
      {% if pagination.hasNext %}
      <a href="?page={{ pagination.nextPage }}" class="btn">下一页</a>
      {% endif %}
    </div>
  </div>
  {% endif %}
  
{% else %}
  <div class="text-center">
    <div class="card">
      <h2>暂无文章</h2>
      <p class="text-muted mb-3">还没有发布任何博客文章</p>
      <a href="/admin" class="btn">去发布文章</a>
    </div>
  </div>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
  // 可以添加一些客户端交互逻辑
  console.log('博客列表页面已加载');
</script>
{% endblock %}
