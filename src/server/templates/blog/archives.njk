{% extends "base.njk" %}

{% block title %}文章归档 - {{ siteConfig.site_name or 'Crispy' }}{% endblock %}

{% block description %}按时间归档的文章列表{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 主内容区域 -->
    <div class="lg:col-span-3">
      <!-- 归档标题 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">文章归档</h1>
        <p class="text-gray-600">按时间顺序浏览所有文章</p>
        <div class="mt-4 text-sm text-gray-500">
          共 {{ pagination.totalItems }} 篇文章
        </div>
      </div>
      
      {% if articles and articles.length > 0 %}
        <div class="bg-white rounded-lg shadow-md">
          {% set currentYear = null %}
          {% set currentMonth = null %}
          
          {% for article in articles %}
            {% set articleYear = article.create_time | dateFormat('YYYY') %}
            {% set articleMonth = article.create_time | dateFormat('MM') %}
            {% set articleMonthName = article.create_time | dateFormat('YYYY年MM月') %}
            
            <!-- 年份分隔 -->
            {% if articleYear != currentYear %}
              {% if not loop.first %}
                </div> <!-- 关闭上一个月份的 div -->
              {% endif %}
              {% set currentYear = articleYear %}
              {% set currentMonth = null %}
              
              <div class="border-b border-gray-200 p-6">
                <h2 class="text-2xl font-bold text-gray-900">{{ articleYear }}年</h2>
              </div>
            {% endif %}
            
            <!-- 月份分隔 -->
            {% if articleMonth != currentMonth %}
              {% if currentMonth != null %}
                </div> <!-- 关闭上一个月份的文章列表 -->
              {% endif %}
              {% set currentMonth = articleMonth %}
              
              <div class="p-6 border-b border-gray-100">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">{{ articleMonthName }}</h3>
                <div class="space-y-3">
            {% endif %}
            
            <!-- 文章项 -->
            <div class="flex items-center justify-between py-2 hover:bg-gray-50 rounded px-2 transition-colors">
              <div class="flex-1">
                <a href="/blog/article/{{ article.id }}" class="text-blue-600 hover:text-blue-800 font-medium transition-colors">
                  {{ article.title }}
                </a>
                {% if article.summary %}
                  <p class="text-gray-600 text-sm mt-1">{{ article.summary | truncate(100) }}</p>
                {% endif %}
              </div>
              <div class="text-right text-sm text-gray-500 ml-4">
                <div>{{ article.create_time | dateFormat('MM-DD') }}</div>
                <div class="text-xs">{{ article.click or 0 }} 阅读</div>
              </div>
            </div>
            
            <!-- 如果是最后一篇文章，关闭月份 div -->
            {% if loop.last %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        
        <!-- 分页 -->
        {% if pagination.totalPages > 1 %}
          <div class="mt-8 flex justify-center">
            <nav class="flex space-x-2">
              {% if pagination.hasPrev %}
                <a href="/blog/archives?page={{ pagination.prevPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">上一页</a>
              {% endif %}
              
              {% for i in range(1, pagination.totalPages + 1) %}
                {% if i == pagination.currentPage %}
                  <span class="px-3 py-2 bg-blue-500 text-white rounded">{{ i }}</span>
                {% else %}
                  <a href="/blog/archives?page={{ i }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">{{ i }}</a>
                {% endif %}
              {% endfor %}
              
              {% if pagination.hasNext %}
                <a href="/blog/archives?page={{ pagination.nextPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">下一页</a>
              {% endif %}
            </nav>
          </div>
        {% endif %}
      {% else %}
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
          <div class="text-gray-400 mb-4">
            <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <p class="text-gray-500 text-lg">暂无文章</p>
        </div>
      {% endif %}
    </div>
    
    <!-- 侧边栏 -->
    <div class="lg:col-span-1">
      <!-- 返回列表 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <a href="/blog" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          返回文章列表
        </a>
      </div>
      
      <!-- 归档统计 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">归档统计</h3>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-600">总文章数</span>
            <span class="font-medium">{{ pagination.totalItems }}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">当前页</span>
            <span class="font-medium">{{ pagination.currentPage }}/{{ pagination.totalPages }}</span>
          </div>
        </div>
      </div>
      
      <!-- 快速导航 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">快速导航</h3>
        <div class="space-y-2">
          <a href="/blog" class="block text-blue-600 hover:text-blue-800 transition-colors">最新文章</a>
          <a href="/blog/search" class="block text-blue-600 hover:text-blue-800 transition-colors">搜索文章</a>
        </div>
      </div>
      
      <!-- 按年份浏览 -->
      {% if articles and articles.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">按年份浏览</h3>
          <div class="space-y-1">
            {% set years = [] %}
            {% for article in articles %}
              {% set year = article.create_time | dateFormat('YYYY') %}
              {% if year not in years %}
                {% set _ = years.push(year) %}
                <a href="/blog/archives?year={{ year }}" class="block text-blue-600 hover:text-blue-800 transition-colors text-sm">
                  {{ year }}年
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
