{% extends "base.njk" %}

{% block title %}{{ category.title }} - Fuwari{% endblock %}

{% block description %}{{ category.title }} - 分类文章列表{% endblock %}

{% block content %}
<!-- 分类信息 -->
<div class="bg-[var(--card-bg)] rounded-[var(--radius-large)] shadow-lg border border-[var(--line-divider)] p-8 mb-8">
  <div class="flex items-center space-x-3 mb-4">
    <div class="w-12 h-12 bg-[var(--primary)]/20 rounded-full flex items-center justify-center">
      <svg class="w-6 h-6 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
    </div>
    <div>
      <div class="flex items-center space-x-2">
        <span class="px-3 py-1 bg-[var(--primary)]/20 text-[var(--primary)] rounded-full text-sm font-medium">分类</span>
        <h1 class="text-3xl font-bold text-[var(--deep-text)]">{{ category.title }}</h1>
      </div>
      <p class="text-[var(--btn-content)] mt-1">{{ category.description or '分类文章列表' }}</p>
      <div class="mt-2 text-sm text-[var(--meta-divider)]">
        Total {{ articles.length }} posts
      </div>
    </div>
  </div>
</div>

<!-- 文章列表 -->
<div class="space-y-6">
  {% for article in articles %}
  <article class="bg-[var(--card-bg)] rounded-[var(--radius-large)] shadow-lg border border-[var(--line-divider)] overflow-hidden hover:shadow-xl transition-all duration-300">
    <div class="p-8">
      <div class="flex items-center space-x-2 mb-4">
        <span class="px-3 py-1 bg-[var(--primary)]/20 text-[var(--primary)] rounded-full text-sm font-medium">
          {{ category.title }}
        </span>
        <span class="text-[var(--meta-divider)]">•</span>
        <span class="text-sm text-[var(--meta-divider)]">{{ article.create_time | dateFormat('YYYY-MM-DD') }}</span>
      </div>

      <h2 class="text-2xl font-bold text-[var(--deep-text)] mb-4 hover:text-[var(--primary)] transition-colors">
        <a href="/archives/{{ article.url }}">{{ article.title }}</a>
      </h2>

      {% if article.summary %}
      <p class="text-[var(--btn-content)] mb-6 line-clamp-2">{{ article.summary }}</p>
      {% endif %}

      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4 text-sm text-[var(--meta-divider)]">
          <div class="flex items-center space-x-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            <span>{{ article.views or 0 }} views</span>
          </div>
          <div class="flex items-center space-x-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>{{ article.words or 0 }} words</span>
          </div>
        </div>

        {% if article.tags %}
        <div class="flex items-center space-x-2">
          {% set tagList = article.tags.split(',') %}
          {% for tagItem in tagList %}
          <a href="/tags/{{ tagItem.trim() }}"
             class="px-3 py-1 bg-[var(--btn-regular-bg)] text-[var(--btn-content)] text-sm rounded-full hover:bg-[var(--btn-regular-bg-hover)] transition-colors">
            {{ tagItem.trim() }}
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </article>
  {% endfor %}
</div>

{% if articles.length === 0 %}
<div class="bg-[var(--card-bg)] rounded-[var(--radius-large)] shadow-lg border border-[var(--line-divider)] p-12 text-center">
  <div class="w-16 h-16 bg-[var(--primary)]/20 rounded-full flex items-center justify-center mx-auto mb-4">
    <svg class="w-8 h-8 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
    </svg>
  </div>
  <h3 class="text-xl font-semibold text-[var(--deep-text)] mb-2">暂无相关文章</h3>
  <p class="text-[var(--btn-content)]">该分类下还没有文章，敬请期待...</p>
</div>
{% endif %}
{% endblock %}
