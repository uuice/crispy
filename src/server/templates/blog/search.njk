{% extends "base.njk" %}

{% block title %}搜索"{{ keyword }}" - {{ siteConfig.site_name or 'Crispy' }}{% endblock %}

{% block description %}搜索关键词"{{ keyword }}"的文章结果{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 主内容区域 -->
    <div class="lg:col-span-3">
      <!-- 搜索结果标题 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">搜索结果</h1>
        {% if keyword %}
          <p class="text-gray-600">
            关键词：<span class="font-medium text-gray-900">"{{ keyword }}"</span>
            {% if pagination.totalItems > 0 %}
              ，共找到 {{ pagination.totalItems }} 篇文章
            {% else %}
              ，未找到相关文章
            {% endif %}
          </p>
        {% else %}
          <p class="text-gray-600">请输入搜索关键词</p>
        {% endif %}
      </div>
      
      <!-- 搜索框 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <form action="/blog/search" method="get">
          <div class="flex">
            <input type="text" name="q" value="{{ keyword }}" placeholder="输入关键词..." class="flex-1 px-4 py-3 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
            <button type="submit" class="px-6 py-3 bg-blue-500 text-white rounded-r-md hover:bg-blue-600 transition-colors">搜索</button>
          </div>
        </form>
      </div>
      
      {% if keyword and articles and articles.length > 0 %}
        <div class="space-y-6">
          {% for article in articles %}
            <article class="bg-white rounded-lg shadow-md p-6">
              <h2 class="text-xl font-semibold text-gray-900 mb-2">
                <a href="/blog/article/{{ article.id }}" class="hover:text-blue-600 transition-colors">
                  {{ article.title | highlight(keyword) | safe }}
                </a>
              </h2>
              
              <div class="text-gray-600 text-sm mb-3">
                <span>{{ article.create_time | dateFormat('YYYY-MM-DD') }}</span>
                {% if article.author %}
                  <span class="mx-2">•</span>
                  <span>{{ article.author }}</span>
                {% endif %}
                <span class="mx-2">•</span>
                <span>{{ article.click or 0 }} 次阅读</span>
              </div>
              
              {% if article.summary %}
                <p class="text-gray-700 mb-3">{{ article.summary | highlight(keyword) | truncate(200) | safe }}</p>
              {% endif %}
              
              {% if article.tags %}
                <div class="flex flex-wrap gap-2">
                  {% set tagList = article.tags.split(',') %}
                  {% for tag in tagList %}
                    <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded">{{ tag.trim() }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
        
        <!-- 分页 -->
        {% if pagination.totalPages > 1 %}
          <div class="mt-8 flex justify-center">
            <nav class="flex space-x-2">
              {% if pagination.hasPrev %}
                <a href="/blog/search?q={{ keyword | urlencode }}&page={{ pagination.prevPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">上一页</a>
              {% endif %}
              
              {% for i in range(1, pagination.totalPages + 1) %}
                {% if i == pagination.currentPage %}
                  <span class="px-3 py-2 bg-blue-500 text-white rounded">{{ i }}</span>
                {% else %}
                  <a href="/blog/search?q={{ keyword | urlencode }}&page={{ i }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">{{ i }}</a>
                {% endif %}
              {% endfor %}
              
              {% if pagination.hasNext %}
                <a href="/blog/search?q={{ keyword | urlencode }}&page={{ pagination.nextPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">下一页</a>
              {% endif %}
            </nav>
          </div>
        {% endif %}
      {% elif keyword %}
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
          <div class="text-gray-400 mb-4">
            <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <p class="text-gray-500 text-lg mb-4">未找到包含"{{ keyword }}"的文章</p>
          <p class="text-gray-400 mb-6">请尝试其他关键词或浏览所有文章</p>
          <a href="/blog" class="inline-block px-6 py-3 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition-colors">浏览所有文章</a>
        </div>
      {% endif %}
    </div>
    
    <!-- 侧边栏 -->
    <div class="lg:col-span-1">
      <!-- 返回列表 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <a href="/blog" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          返回文章列表
        </a>
      </div>
      
      <!-- 热门搜索 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">搜索建议</h3>
        <div class="space-y-2 text-sm">
          <p class="text-gray-600">• 使用更简短的关键词</p>
          <p class="text-gray-600">• 检查拼写是否正确</p>
          <p class="text-gray-600">• 尝试使用同义词</p>
          <p class="text-gray-600">• 减少搜索词数量</p>
        </div>
      </div>
      
      <!-- 分类 -->
      {% if categories and categories.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">按分类浏览</h3>
          <ul class="space-y-2">
            {% for category in categories %}
              <li>
                <a href="/blog/category/{{ category.id }}" class="text-blue-600 hover:text-blue-800 transition-colors">
                  {{ category.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      
      <!-- 标签云 -->
      {% if tags and tags.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">标签云</h3>
          <div class="flex flex-wrap gap-2">
            {% for tag in tags %}
              <a href="/blog/tag/{{ tag.id }}" class="px-2 py-1 bg-gray-100 text-gray-700 text-sm rounded hover:bg-blue-100 hover:text-blue-800 transition-colors">
                {{ tag.title }}
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
