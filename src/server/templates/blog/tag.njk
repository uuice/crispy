{% extends "base.njk" %}

{% block title %}{{ tag.title }} - 标签 - {{ siteConfig.site_name or 'Crispy' }}{% endblock %}

{% block description %}标签"{{ tag.title }}"下的文章列表{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 主内容区域 -->
    <div class="lg:col-span-3">
      <!-- 标签信息 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <div class="flex items-center mb-2">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm mr-3">标签</span>
          <h1 class="text-3xl font-bold text-gray-900">{{ tag.title }}</h1>
        </div>
        {% if tag.description %}
          <p class="text-gray-600">{{ tag.description }}</p>
        {% endif %}
        <div class="mt-4 text-sm text-gray-500">
          共 {{ pagination.totalItems }} 篇文章
        </div>
      </div>
      
      {% if articles and articles.length > 0 %}
        <div class="space-y-6">
          {% for article in articles %}
            <article class="bg-white rounded-lg shadow-md p-6">
              <h2 class="text-xl font-semibold text-gray-900 mb-2">
                <a href="/blog/article/{{ article.id }}" class="hover:text-blue-600 transition-colors">
                  {{ article.title }}
                </a>
              </h2>
              
              <div class="text-gray-600 text-sm mb-3">
                <span>{{ article.create_time | dateFormat('YYYY-MM-DD') }}</span>
                {% if article.author %}
                  <span class="mx-2">•</span>
                  <span>{{ article.author }}</span>
                {% endif %}
                <span class="mx-2">•</span>
                <span>{{ article.click or 0 }} 次阅读</span>
              </div>
              
              {% if article.summary %}
                <p class="text-gray-700 mb-3">{{ article.summary | truncate(150) }}</p>
              {% endif %}
              
              {% if article.tags %}
                <div class="flex flex-wrap gap-2">
                  {% set tagList = article.tags.split(',') %}
                  {% for tagName in tagList %}
                    {% set trimmedTag = tagName.trim() %}
                    <span class="px-2 py-1 text-xs rounded {{ 'bg-blue-100 text-blue-800' if trimmedTag == tag.title else 'bg-gray-100 text-gray-700' }}">
                      {{ trimmedTag }}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
        
        <!-- 分页 -->
        {% if pagination.totalPages > 1 %}
          <div class="mt-8 flex justify-center">
            <nav class="flex space-x-2">
              {% if pagination.hasPrev %}
                <a href="/blog/tag/{{ tag.id }}?page={{ pagination.prevPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">上一页</a>
              {% endif %}
              
              {% for i in range(1, pagination.totalPages + 1) %}
                {% if i == pagination.currentPage %}
                  <span class="px-3 py-2 bg-blue-500 text-white rounded">{{ i }}</span>
                {% else %}
                  <a href="/blog/tag/{{ tag.id }}?page={{ i }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">{{ i }}</a>
                {% endif %}
              {% endfor %}
              
              {% if pagination.hasNext %}
                <a href="/blog/tag/{{ tag.id }}?page={{ pagination.nextPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">下一页</a>
              {% endif %}
            </nav>
          </div>
        {% endif %}
      {% else %}
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
          <p class="text-gray-500 text-lg">该标签下暂无文章</p>
          <a href="/blog" class="mt-4 inline-block text-blue-600 hover:text-blue-800">返回文章列表</a>
        </div>
      {% endif %}
    </div>
    
    <!-- 侧边栏 -->
    <div class="lg:col-span-1">
      <!-- 返回列表 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <a href="/blog" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          返回文章列表
        </a>
      </div>
      
      <!-- 相关标签 -->
      {% if tags and tags.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">相关标签</h3>
          <div class="flex flex-wrap gap-2">
            {% for relatedTag in tags %}
              {% if relatedTag.id != tag.id %}
                <a href="/blog/tag/{{ relatedTag.id }}" class="px-2 py-1 bg-gray-100 text-gray-700 text-sm rounded hover:bg-blue-100 hover:text-blue-800 transition-colors">
                  {{ relatedTag.title }}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
      
      <!-- 分类 -->
      {% if categories and categories.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">文章分类</h3>
          <ul class="space-y-2">
            {% for category in categories %}
              <li>
                <a href="/blog/category/{{ category.id }}" class="text-blue-600 hover:text-blue-800 transition-colors">
                  {{ category.title }}
                </a>
                {% if category.children and category.children.length > 0 %}
                  <ul class="ml-4 mt-2 space-y-1">
                    {% for child in category.children %}
                      <li>
                        <a href="/blog/category/{{ child.id }}" class="text-gray-600 hover:text-blue-600 transition-colors text-sm">
                          {{ child.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
