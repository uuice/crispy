{% extends "base.njk" %}

{% block title %}博客 - {{ siteConfig.site_name or 'Crispy' }}{% endblock %}

{% block description %}{{ siteConfig.site_description or '博客文章列表' }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 主内容区域 -->
    <div class="lg:col-span-3">
      <h1 class="text-3xl font-bold text-gray-900 mb-8">最新文章</h1>
      
      {% if articles and articles.length > 0 %}
        <div class="space-y-8">
          {% for article in articles %}
            <article class="bg-white rounded-lg shadow-md overflow-hidden">
              {% if article.cover_image %}
                <img src="{{ article.cover_image }}" alt="{{ article.title }}" class="w-full h-48 object-cover">
              {% endif %}
              
              <div class="p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-2">
                  <a href="/blog/article/{{ article.id }}" class="hover:text-blue-600 transition-colors">
                    {{ article.title }}
                  </a>
                </h2>
                
                <div class="text-gray-600 text-sm mb-4">
                  <span>{{ article.create_time | dateFormat('YYYY-MM-DD') }}</span>
                  {% if article.author %}
                    <span class="mx-2">•</span>
                    <span>{{ article.author }}</span>
                  {% endif %}
                  <span class="mx-2">•</span>
                  <span>{{ article.click or 0 }} 次阅读</span>
                </div>
                
                {% if article.summary %}
                  <p class="text-gray-700 mb-4">{{ article.summary | truncate(200) }}</p>
                {% endif %}
                
                {% if article.tags %}
                  <div class="flex flex-wrap gap-2">
                    {% set tagList = article.tags.split(',') %}
                    {% for tag in tagList %}
                      <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded">{{ tag.trim() }}</span>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
        
        <!-- 分页 -->
        {% if pagination.totalPages > 1 %}
          <div class="mt-8 flex justify-center">
            <nav class="flex space-x-2">
              {% if pagination.hasPrev %}
                <a href="/blog?page={{ pagination.prevPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">上一页</a>
              {% endif %}
              
              {% for i in range(1, pagination.totalPages + 1) %}
                {% if i == pagination.currentPage %}
                  <span class="px-3 py-2 bg-blue-500 text-white rounded">{{ i }}</span>
                {% else %}
                  <a href="/blog?page={{ i }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">{{ i }}</a>
                {% endif %}
              {% endfor %}
              
              {% if pagination.hasNext %}
                <a href="/blog?page={{ pagination.nextPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">下一页</a>
              {% endif %}
            </nav>
          </div>
        {% endif %}
      {% else %}
        <div class="text-center py-12">
          <p class="text-gray-500 text-lg">暂无文章</p>
        </div>
      {% endif %}
    </div>
    
    <!-- 侧边栏 -->
    <div class="lg:col-span-1">
      <!-- 搜索框 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">搜索文章</h3>
        <form action="/blog/search" method="get">
          <div class="flex">
            <input type="text" name="q" placeholder="输入关键词..." class="flex-1 px-3 py-2 border border-gray-300 rounded-l-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-r-md hover:bg-blue-600">搜索</button>
          </div>
        </form>
      </div>
      
      <!-- 分类 -->
      {% if categories and categories.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">文章分类</h3>
          <ul class="space-y-2">
            {% for category in categories %}
              <li>
                <a href="/blog/category/{{ category.id }}" class="text-blue-600 hover:text-blue-800 transition-colors">
                  {{ category.title }}
                </a>
                {% if category.children and category.children.length > 0 %}
                  <ul class="ml-4 mt-2 space-y-1">
                    {% for child in category.children %}
                      <li>
                        <a href="/blog/category/{{ child.id }}" class="text-gray-600 hover:text-blue-600 transition-colors text-sm">
                          {{ child.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      
      <!-- 标签云 -->
      {% if tags and tags.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">标签云</h3>
          <div class="flex flex-wrap gap-2">
            {% for tag in tags %}
              <a href="/blog/tag/{{ tag.id }}" class="px-2 py-1 bg-gray-100 text-gray-700 text-sm rounded hover:bg-blue-100 hover:text-blue-800 transition-colors">
                {{ tag.title }}
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
