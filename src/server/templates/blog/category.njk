{% extends "base.njk" %}

{% block title %}{{ category.title }} - 分类 - {{ siteConfig.site_name or 'Crispy' }}{% endblock %}

{% block description %}{{ category.description or category.title }}分类下的文章列表{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- 主内容区域 -->
    <div class="lg:col-span-3">
      <!-- 分类信息 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ category.title }}</h1>
        {% if category.description %}
          <p class="text-gray-600">{{ category.description }}</p>
        {% endif %}
        <div class="mt-4 text-sm text-gray-500">
          共 {{ pagination.totalItems }} 篇文章
        </div>
      </div>
      
      {% if articles and articles.length > 0 %}
        <div class="space-y-6">
          {% for article in articles %}
            <article class="bg-white rounded-lg shadow-md p-6">
              <h2 class="text-xl font-semibold text-gray-900 mb-2">
                <a href="/blog/article/{{ article.id }}" class="hover:text-blue-600 transition-colors">
                  {{ article.title }}
                </a>
              </h2>
              
              <div class="text-gray-600 text-sm mb-3">
                <span>{{ article.create_time | dateFormat('YYYY-MM-DD') }}</span>
                {% if article.author %}
                  <span class="mx-2">•</span>
                  <span>{{ article.author }}</span>
                {% endif %}
                <span class="mx-2">•</span>
                <span>{{ article.click or 0 }} 次阅读</span>
              </div>
              
              {% if article.summary %}
                <p class="text-gray-700 mb-3">{{ article.summary | truncate(150) }}</p>
              {% endif %}
              
              {% if article.tags %}
                <div class="flex flex-wrap gap-2">
                  {% set tagList = article.tags.split(',') %}
                  {% for tag in tagList %}
                    <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded">{{ tag.trim() }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
        
        <!-- 分页 -->
        {% if pagination.totalPages > 1 %}
          <div class="mt-8 flex justify-center">
            <nav class="flex space-x-2">
              {% if pagination.hasPrev %}
                <a href="/blog/category/{{ category.id }}?page={{ pagination.prevPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">上一页</a>
              {% endif %}
              
              {% for i in range(1, pagination.totalPages + 1) %}
                {% if i == pagination.currentPage %}
                  <span class="px-3 py-2 bg-blue-500 text-white rounded">{{ i }}</span>
                {% else %}
                  <a href="/blog/category/{{ category.id }}?page={{ i }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">{{ i }}</a>
                {% endif %}
              {% endfor %}
              
              {% if pagination.hasNext %}
                <a href="/blog/category/{{ category.id }}?page={{ pagination.nextPage }}" class="px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">下一页</a>
              {% endif %}
            </nav>
          </div>
        {% endif %}
      {% else %}
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
          <p class="text-gray-500 text-lg">该分类下暂无文章</p>
          <a href="/blog" class="mt-4 inline-block text-blue-600 hover:text-blue-800">返回文章列表</a>
        </div>
      {% endif %}
    </div>
    
    <!-- 侧边栏 -->
    <div class="lg:col-span-1">
      <!-- 返回列表 -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <a href="/blog" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          返回文章列表
        </a>
      </div>
      
      <!-- 其他分类 -->
      {% if categories and categories.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">其他分类</h3>
          <ul class="space-y-2">
            {% for cat in categories %}
              {% if cat.id != category.id %}
                <li>
                  <a href="/blog/category/{{ cat.id }}" class="text-blue-600 hover:text-blue-800 transition-colors">
                    {{ cat.title }}
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      
      <!-- 标签云 -->
      {% if tags and tags.length > 0 %}
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">标签云</h3>
          <div class="flex flex-wrap gap-2">
            {% for tag in tags %}
              <a href="/blog/tag/{{ tag.id }}" class="px-2 py-1 bg-gray-100 text-gray-700 text-sm rounded hover:bg-blue-100 hover:text-blue-800 transition-colors">
                {{ tag.title }}
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
