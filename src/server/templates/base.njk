  <meta name="author" content="Lorem Ipsum">
  <meta property="og:site_name" content="Fuwari">
  <meta property="og:url" content="https://fuwari.vercel.app/">
  <meta property="og:title" content="Fuwari - Demo Site">
  <meta property="og:description" content="Fuwari - Demo Site">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
