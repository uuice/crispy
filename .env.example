# Server Configuration
PORT=4200
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Database Configuration
DATABASE_URL="mysql://test:password@47.103.129.149:3306/test"

# Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=test
DB_USER=test
DB_PASSWORD=password

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Swagger Documentation Configuration
# 开发环境：通常不需要设置，自动使用 localhost
# SWAGGER_BASE_URL=http://localhost:4200

# 测试环境：使用测试服务器域名
# SWAGGER_BASE_URL=https://test-api.crispy.com

# 生产环境：使用生产服务器域名
# SWAGGER_BASE_URL=https://api.crispy.com

# 或者使用通用的 BASE_URL（优先级更高）
# BASE_URL=https://your-domain.com

# 说明：
# 1. 开发环境：不设置任何 URL，自动使用 localhost:PORT
# 2. 生产环境：设置 BASE_URL 或 SWAGGER_BASE_URL 为实际域名
# 3. 如果都不设置，生产环境将使用相对路径（让浏览器自动确定域名）

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=dev
