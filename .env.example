# Local development: SQLite (no Docker)
# DATABASE_URL=file:./.data/payload.db
# DATABASE_PUSH=false

# Production / remote PostgreSQL
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Remote DB often needs one of:
# DATABASE_URL=postgresql://...?sslmode=require
# DATABASE_URL=postgresql://...?sslmode=disable
DATABASE_PUSH=false

# pgvector / semantic search (PostgreSQL only). Set false when the server has no vector extension.
PGVECTOR_ENABLED=false

# Optional override: sqlite | postgres (auto-detected from DATABASE_URL if omitted)
# DATABASE_DRIVER=sqlite

# Payload JWT encryption (generate: openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3333

# Middleware internal self-fetch (production behind reverse proxy; optional override)
# CRISPY_INTERNAL_ORIGIN=http://127.0.0.1:3333

# Cron jobs (scheduled publish)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Draft / live preview
PREVIEW_SECRET=preview-dev-secret

# MCP verification (from seed log or Admin → MCP → API Keys)
# MCP_API_KEY=

# API access logging (middleware → api-access-logs collection)
# API_ACCESS_LOG_ENABLED=true
# ACCESS_LOG_SECRET=           # defaults to PAYLOAD_SECRET

# S3 storage — media collection (optional in dev; recommended in production)
# Enabled when S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY are all set.
# Without S3, uploads go to public/media/ on local disk.
#
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_PREFIX=media
# Upload path: {S3_PREFIX}/{YYYY}/{MM}/{DD}/{filename} (stored in media.prefix as full path)
# S3_ENDPOINT=              # required for S3-compatible services (not plain AWS)
# S3_FORCE_PATH_STYLE=true  # MinIO / R2: true; Aliyun OSS: usually false
#
# --- Aliyun OSS (S3 compatible) — example: cn-hangzhou ---
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=LTAIxxxxxxxxxxxx
# S3_SECRET_ACCESS_KEY=your-ram-user-secret
# S3_REGION=oss-cn-hangzhou
# S3_PREFIX=media
# Upload path: {S3_PREFIX}/{YYYY}/{MM}/{DD}/{filename} (stored in media.prefix as full path)
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_FORCE_PATH_STYLE=false
# Other regions: oss-cn-shanghai / oss-cn-beijing / oss-cn-shenzhen
# Endpoint: https://oss-<region-suffix>.aliyuncs.com (e.g. https://oss-cn-shanghai.aliyuncs.com)
# Use a RAM user with oss:PutObject, oss:GetObject, oss:DeleteObject, oss:ListObjects on the bucket.
#
# Optional public CDN/custom domain (virtual sizes + browser access). If unset, uses S3_ENDPOINT/bucket/key.
# S3_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
#
# Aliyun OSS image processing: one original on OSS, virtual size URLs in DB (default when S3 is enabled; no Sharp).
# CRISPY_OSS_VIRTUAL_SIZES=false

# Unsplash (Admin media list import, optional)
# UNSPLASH_ACCESS_KEY=

# LLM / AI (Admin 内 AI 助手，OpenAI 兼容协议)
# 通用配置（任意提供商均可使用）：
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# DeepSeek（后台 AI 设置选 DeepSeek 时使用）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI（后台 AI 设置选 OpenAI 时使用）
# OPENAI_API_KEY=
# 注意：Base URL 不要带 /v1 后缀（代码会自动拼接 /v1/chat/completions）

# Embedding / 语义搜索（PostgreSQL + pgvector，需 PGVECTOR_ENABLED 未设为 false）
# DeepSeek 官方无 embedding 接口；可与聊天分开配置上游。
#
# OpenAI 示例：
# LLM_EMBEDDING_API_KEY=
# LLM_EMBEDDING_BASE_URL=https://api.openai.com
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM_EMBEDDING_DIMENSIONS=1536
#
# 硅基流动 + Qwen3-Embedding（须与库表 vector(1536) 一致）：
# LLM_EMBEDDING_API_KEY=
# LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn
# LLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# LLM_EMBEDDING_DIMENSIONS=1536

# Form Builder 邮件（二选一；未配置时表单仍可提交，但不会发邮件）
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=Crispy CMS
# FORM_DEFAULT_TO_EMAIL=admin@yourdomain.com
# EMAIL_OVERRIDE_RECIPIENT=           # 测试：所有邮件重定向到此地址
#
# Resend（推荐）
# RESEND_API_KEY=
#
# SMTP / Nodemailer
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

