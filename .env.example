# Local development: SQLite (no Docker)
# DATABASE_URL=file:./.data/payload.db
# DATABASE_PUSH=false

# Production / remote PostgreSQL
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Remote DB often needs one of:
# DATABASE_URL=postgresql://...?sslmode=require
# DATABASE_URL=postgresql://...?sslmode=disable
DATABASE_PUSH=false

# pgvector / semantic search (PostgreSQL only). Set false when the server has no vector extension.
PGVECTOR_ENABLED=false

# Optional override: sqlite | postgres (auto-detected from DATABASE_URL if omitted)
# DATABASE_DRIVER=sqlite

# Payload JWT encryption (generate: openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL (no trailing slash).
# Used at build-time for sitemap/OG/etc. When packing for production, set the real domain:
#   NEXT_PUBLIC_SERVER_URL=https://uuice.com pnpm cli dev:pack-linux
# Local dev stays http://localhost:3333 — do not put production URL in the machine you develop on
# unless you are intentionally building a production tarball.
NEXT_PUBLIC_SERVER_URL=http://localhost:3333

# Runtime-only public origin for redirects (NOT inlined at build). Prefer this on the server
# if the tarball was built with localhost NEXT_PUBLIC_SERVER_URL.
# CRISPY_PUBLIC_ORIGIN=https://uuice.com

# Middleware internal self-fetch (production behind reverse proxy; optional override)
# Must match the PORT the Node process actually listens on.
# CRISPY_INTERNAL_ORIGIN=http://127.0.0.1:3333

# Listen bind (standalone start.sh). 0.0.0.0 is correct for bind — do NOT put it in NEXT_PUBLIC_SERVER_URL.
# HOSTNAME=0.0.0.0
# PORT=3333

# Cron jobs (scheduled publish)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Draft / live preview
PREVIEW_SECRET=preview-dev-secret

# MCP verification (from seed log or Admin → MCP → API Keys)
# MCP_API_KEY=

# API access logging (middleware → api-access-logs collection)
# API_ACCESS_LOG_ENABLED=true
# ACCESS_LOG_SECRET=           # defaults to PAYLOAD_SECRET

# ---------------------------------------------------------------------------
# LLM / S3 / Unsplash / Email — configure in Admin only
# 配置 → LLM 提供商 / AI 设置 / 存储目标 / 集成凭证 / 邮件通道
# Docs: /admin/dev-docs#config-center
# S3 & Email Active changes require process restart (runtime JSON at .data/*-runtime.json)
# ---------------------------------------------------------------------------

# Frontend HTML cache (development only; overrides Admin → cache-settings global)
# CRISPY_FRONTEND_HTML_CACHE=true
# CRISPY_FRONTEND_HTML_CACHE=false
